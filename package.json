{
  "name": "pacer-programmer",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "docs:walkthrough": "node scripts/docs-walkthrough.mjs",
    "check:map": "node scripts/map-check.mjs",
    "deploy:app": "pnpm build && wrangler deploy",
    "docs:build": "vitepress build docs && node scripts/docs-site-check.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitepress": "1.6.4",
    "vitest": "^2.1.8",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "xstate": "^5.33.2",
    "zustand": "^5.0.15"
  }
}

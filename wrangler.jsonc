//
// The app, deployed as a Cloudflare Worker that only serves the built files (`pnpm build`), with no
// code of its own. Headers are in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacer-programmer",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  // Only the custom domain: no workers.dev address and no preview addresses. Saved snapshots live in
  // the browser's storage for one origin, so a second address would hold a second, separate set.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pacer-programmer.softdoglabs.com", "custom_domain": true }],
}

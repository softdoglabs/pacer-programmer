# Beyond the app's own origin, the policy allows two analytics services. Cloudflare Web Analytics:
# Cloudflare injects its beacon from static.cloudflareinsights.com, and it reports to this site's
# own /cdn-cgi/rum. Google Analytics 4: the hosts Google lists for it
# (developers.google.com/tag-platform/security/guides/csp).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self' data:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: midi=(self), camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Previews and per-version addresses (pr-<n>-<hex>-pacer-programmer.<account>.workers.dev): kept out
# of search results, so the app is found at its own address. The live hostname doesn't match.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Vite names these by content hash, so a name never changes meaning. A day for now; a year once
# it's confirmed how Cloudflare treats a previous deploy's files.
/assets/*
  Cache-Control: public, max-age=86400, immutable

# The page that names the current hashes: always check for a newer one.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
